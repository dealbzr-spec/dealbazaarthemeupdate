<div class="boat-active-offers-block" {{ block.shopify_attributes }}>

  <!-- Native Product & Collection Selector Inside Active Offers -->
  {% if block.settings.enable_option_picker %}
    <div class="boat-active-offers-picker-section">
      {% if block.settings.picker_label != blank %}
        <label class="form__label boat-option-label">
          <span class="boat-choose-prefix">{{ block.settings.picker_label }}</span>
          <span class="boat-selected-option-title" id="active-offers-selected-option-{{ block.id }}">
            {{ product.title }}
          </span>
        </label>
      {% endif %}

      <div class="collection-picker-options-grid">
        {% if block.settings.picker_mode == 'products' %}
          <!-- Native Shopify Product Pickers (Product 1, 2, 3, 4) -->
          {% assign p1 = block.settings.product_1 %}
          {% assign p2 = block.settings.product_2 %}
          {% assign p3 = block.settings.product_3 %}
          {% assign p4 = block.settings.product_4 %}

          {% if p1 != blank %}
            <a href="{{ p1.url }}" class="collection-picker-option-card{% if p1.id == product.id %} is-selected{% endif %}">
              {% if p1.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ p1.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ p1.title | escape }}" width="50" height="50" loading="lazy">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ p1.title }}</span>
                <span class="collection-picker-price">{{ p1.price | money }}</span>
              </div>
            </a>
          {% endif %}

          {% if p2 != blank %}
            <a href="{{ p2.url }}" class="collection-picker-option-card{% if p2.id == product.id %} is-selected{% endif %}">
              {% if p2.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ p2.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ p2.title | escape }}" width="50" height="50" loading="lazy">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ p2.title }}</span>
                <span class="collection-picker-price">{{ p2.price | money }}</span>
              </div>
            </a>
          {% endif %}

          {% if p3 != blank %}
            <a href="{{ p3.url }}" class="collection-picker-option-card{% if p3.id == product.id %} is-selected{% endif %}">
              {% if p3.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ p3.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ p3.title | escape }}" width="50" height="50" loading="lazy">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ p3.title }}</span>
                <span class="collection-picker-price">{{ p3.price | money }}</span>
              </div>
            </a>
          {% endif %}

          {% if p4 != blank %}
            <a href="{{ p4.url }}" class="collection-picker-option-card{% if p4.id == product.id %} is-selected{% endif %}">
              {% if p4.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ p4.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ p4.title | escape }}" width="50" height="50" loading="lazy">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ p4.title }}</span>
                <span class="collection-picker-price">{{ p4.price | money }}</span>
              </div>
            </a>
          {% endif %}

        {% elsif block.settings.picker_mode == 'collection' and block.settings.collection != blank %}
          <!-- Native Shopify Collection Picker Mode -->
          {% for collection_product in block.settings.collection.products limit: block.settings.products_limit %}
            <a 
              href="{{ collection_product.url }}" 
              class="collection-picker-option-card{% if collection_product.id == product.id %} is-selected{% endif %}"
              title="{{ collection_product.title | escape }}"
            >
              {% if collection_product.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ collection_product.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ collection_product.title | escape }}" width="50" height="50" loading="lazy">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ collection_product.title }}</span>
                <span class="collection-picker-price">{{ collection_product.price | money }}</span>
              </div>
            </a>
          {% endfor %}
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- Active Offers Cards Section -->
  {% if block.settings.title != blank %}
    <h3 class="boat-offers-heading">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="boat-offers-grid">
    <!-- Card 1 -->
    {% if block.settings.enable_card_1 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_1 != blank %}
          <div class="boat-offer-badge boat-offer-badge--1">{{ block.settings.badge_1 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_1 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_1 }}</div>
          {% if block.settings.code_1 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_1 }}')">
              <span>Code: <strong>{{ block.settings.code_1 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 2 -->
    {% if block.settings.enable_card_2 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_2 != blank %}
          <div class="boat-offer-badge boat-offer-badge--2">{{ block.settings.badge_2 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_2 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_2 }}</div>
          {% if block.settings.code_2 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_2 }}')">
              <span>Code: <strong>{{ block.settings.code_2 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 3 -->
    {% if block.settings.enable_card_3 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_3 != blank %}
          <div class="boat-offer-badge boat-offer-badge--3">{{ block.settings.badge_3 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_3 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_3 }}</div>
          {% if block.settings.code_3 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_3 }}')">
              <span>Code: <strong>{{ block.settings.code_3 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  function copyOfferCode(btn, code) {
    if (!code) return;
    navigator.clipboard.writeText(code).then(function() {
      btn.classList.add('copied');
      setTimeout(function() {
        btn.classList.remove('copied');
      }, 1500);
    }).catch(function(err) {
      console.error('Failed to copy code: ', err);
    });
  }
</script>

{% schema %}
{
  "name": "boAt Active Offers",
  "settings": [
    {
      "type": "header",
      "content": "Product & Collection Selector Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_option_picker",
      "label": "Enable Product / Collection Selector",
      "default": true
    },
    {
      "type": "text",
      "id": "picker_label",
      "label": "Option Group Label",
      "default": "Select Product / Pack :"
    },
    {
      "type": "select",
      "id": "picker_mode",
      "label": "Selection Source",
      "options": [
        {
          "value": "products",
          "label": "Select Individual Products"
        },
        {
          "value": "collection",
          "label": "Select a Collection"
        }
      ],
      "default": "products"
    },
    {
      "type": "header",
      "content": "Individual Products Picker Mode"
    },
    {
      "type": "product",
      "id": "product_1",
      "label": "Select Product 1"
    },
    {
      "type": "product",
      "id": "product_2",
      "label": "Select Product 2"
    },
    {
      "type": "product",
      "id": "product_3",
      "label": "Select Product 3"
    },
    {
      "type": "product",
      "id": "product_4",
      "label": "Select Product 4"
    },
    {
      "type": "header",
      "content": "Collection Picker Mode"
    },
    {
      "type": "collection",
      "id": "collection",
      "label": "Select Collection"
    },
    {
      "type": "range",
      "id": "products_limit",
      "min": 2,
      "max": 8,
      "step": 1,
      "label": "Max Products from Collection",
      "default": 4
    },
    {
      "type": "header",
      "content": "Active Offers Cards Settings"
    },
    {
      "type": "text",
      "id": "title",

      "default": "Active Offers"
    },
    {
      "type": "header",
      "content": "Card 1 Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_card_1",
      "label": "Enable Card 1",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_1",
      "label": "Badge Tag",
      "default": "MOST POPULAR"
    },
    {
      "type": "text",
      "id": "title_1",
      "label": "Offer Title",
      "default": "Buy 2 or more"
    },
    {
      "type": "text",
      "id": "discount_1",
      "label": "Discount Subtitle",
      "default": "Get 6% Off"
    },
    {
      "type": "text",
      "id": "code_1",
      "label": "Promo Code",
      "default": "BOAT6"
    },
    {
      "type": "header",
      "content": "Card 2 Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_card_2",
      "label": "Enable Card 2",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_2",
      "label": "Badge Tag",
      "default": "BEST VALUE"
    },
    {
      "type": "text",
      "id": "title_2",
      "label": "Offer Title",
      "default": "Buy 5 or more"
    },
    {
      "type": "text",
      "id": "discount_2",
      "label": "Discount Subtitle",
      "default": "Get 7% Off"
    },
    {
      "type": "text",
      "id": "code_2",
      "label": "Promo Code",
      "default": "BOAT7"
    },
    {
      "type": "header",
      "content": "Card 3 Settings"
    },
    {
      "type": "checkbox",
      "id": "enable_card_3",
      "label": "Enable Card 3",
      "default": true
    },
    {
      "type": "text",
      "id": "badge_3",
      "label": "Badge Tag",
      "default": "MOST SAVINGS"
    },
    {
      "type": "text",
      "id": "title_3",
      "label": "Offer Title",
      "default": "Buy 10 or more"
    },
    {
      "type": "text",
      "id": "discount_3",
      "label": "Discount Subtitle",
      "default": "Get 10% Off"
    },
    {
      "type": "text",
      "id": "code_3",
      "label": "Promo Code",
      "default": "BOAT10"
    }
  ],
  "presets": [
    {
      "name": "boAt Active Offers"
    }
  ]
}
{% endschema %}

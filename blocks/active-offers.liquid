{%- liquid
  assign show_block = false
  assign visibility = block.settings.visibility | default: 'all'

  if request.visual_preview_mode
    assign show_block = true
  elsif visibility == 'all'
    assign show_block = true
  elsif visibility == 'specific_products'
    if block.settings.target_product_1.id == product.id or block.settings.target_product_2.id == product.id or block.settings.target_product_3.id == product.id or block.settings.target_product_4.id == product.id or block.settings.target_product_5.id == product.id
      assign show_block = true
    endif
  elsif visibility == 'collection' and block.settings.target_collection != blank
    for col in product.collections
      if col.handle == block.settings.target_collection.handle
        assign show_block = true
        break
      endif
    endfor
  elsif visibility == 'tag' and block.settings.target_tag != blank
    assign tag_lower = block.settings.target_tag | downcase | strip
    for tag in product.tags
      assign ptag_lower = tag | downcase | strip
      if ptag_lower == tag_lower
        assign show_block = true
        break
      endif
    endfor
  endif

  # Calculate discounted prices per card based on product price
  assign p_price = product.price | default: 0

  assign pct_1 = block.settings.pct_1 | default: 6
  assign mult_1 = 100 | minus: pct_1
  assign unit_price_1 = p_price | times: mult_1 | divided_by: 100

  assign pct_2 = block.settings.pct_2 | default: 7
  assign mult_2 = 100 | minus: pct_2
  assign unit_price_2 = p_price | times: mult_2 | divided_by: 100

  assign pct_3 = block.settings.pct_3 | default: 10
  assign mult_3 = 100 | minus: pct_3
  assign unit_price_3 = p_price | times: mult_3 | divided_by: 100
-%}

{%- if show_block -%}
<div class="boat-active-offers-block" {{ block.shopify_attributes }}>

  <!-- Active Offers Cards Section -->
  {% if block.settings.title != blank %}
    <h3 class="boat-offers-heading">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="boat-offers-grid">
    <!-- Card 1 -->
    {% if block.settings.enable_card_1 %}
      <div 
        class="boat-offer-card" 
        onclick="applyOfferCard(this, {{ block.settings.qty_1 | default: 2 }}, '{{ block.settings.code_1 | escape }}', {{ pct_1 }}, {{ p_price }})"
      >
        {% if block.settings.badge_1 != blank %}
          <div class="boat-offer-badge boat-offer-badge--1">{{ block.settings.badge_1 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_1 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_1 }}</div>
          {% if p_price > 0 %}
            <div class="boat-offer-calc-price">
              {{ unit_price_1 | money }}/ea
            </div>
          {% endif %}
          {% if block.settings.code_1 != blank %}
            <button type="button" class="boat-offer-code-btn">
              <span>Code: <strong>{{ block.settings.code_1 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Applied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 2 -->
    {% if block.settings.enable_card_2 %}
      <div 
        class="boat-offer-card" 
        onclick="applyOfferCard(this, {{ block.settings.qty_2 | default: 5 }}, '{{ block.settings.code_2 | escape }}', {{ pct_2 }}, {{ p_price }})"
      >
        {% if block.settings.badge_2 != blank %}
          <div class="boat-offer-badge boat-offer-badge--2">{{ block.settings.badge_2 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_2 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_2 }}</div>
          {% if p_price > 0 %}
            <div class="boat-offer-calc-price">
              {{ unit_price_2 | money }}/ea
            </div>
          {% endif %}
          {% if block.settings.code_2 != blank %}
            <button type="button" class="boat-offer-code-btn">
              <span>Code: <strong>{{ block.settings.code_2 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Applied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 3 -->
    {% if block.settings.enable_card_3 %}
      <div 
        class="boat-offer-card" 
        onclick="applyOfferCard(this, {{ block.settings.qty_3 | default: 10 }}, '{{ block.settings.code_3 | escape }}', {{ pct_3 }}, {{ p_price }})"
      >
        {% if block.settings.badge_3 != blank %}
          <div class="boat-offer-badge boat-offer-badge--3">{{ block.settings.badge_3 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_3 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_3 }}</div>
          {% if p_price > 0 %}
            <div class="boat-offer-calc-price">
              {{ unit_price_3 | money }}/ea
            </div>
          {% endif %}
          {% if block.settings.code_3 != blank %}
            <button type="button" class="boat-offer-code-btn">
              <span>Code: <strong>{{ block.settings.code_3 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Applied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  window.boatActiveOfferDiscountPct = 0;
  window.boatActiveOfferCode = '';
  window.boatBasePrice = 0;

  function applyOfferCard(cardEl, qty, code, pct, basePrice) {
    window.boatActiveOfferDiscountPct = pct;
    window.boatActiveOfferCode = code;
    window.boatBasePrice = basePrice;

    // 1. Highlight clicked card
    const parent = cardEl.closest('.boat-offers-grid');
    if (parent) {
      parent.querySelectorAll('.boat-offer-card').forEach(c => c.classList.remove('is-selected'));
    }
    cardEl.classList.add('is-selected');

    // 2. Set Quantity Input on Product Form
    const qtyInputs = document.querySelectorAll('input[name="quantity"], input.quantity__input, input[name*="updates"]');
    qtyInputs.forEach(input => {
      input.value = qty;
      input.dispatchEvent(new Event('change', { bubbles: true }));
      input.dispatchEvent(new Event('input', { bubbles: true }));
    });

    // 3. Update Subtotal on Page
    setTimeout(function() {
      updateDiscountedSubtotalDisplay(qty, pct, basePrice);
    }, 60);

    // 4. Apply Discount Code to session
    if (code) {
      fetch('/discount/' + encodeURIComponent(code)).catch(function(){});
      if (navigator.clipboard) {
        navigator.clipboard.writeText(code).catch(function(){});
      }
    }

    // 5. Visual Feedback
    const btn = cardEl.querySelector('.boat-offer-code-btn');
    if (btn) {
      btn.classList.add('copied');
      setTimeout(function() {
        btn.classList.remove('copied');
      }, 2000);
    }
  }

  function updateDiscountedSubtotalDisplay(qty, pct, basePrice) {
    if (!basePrice || !pct) return;
    const discountedUnitPrice = (basePrice * (100 - pct)) / 100;
    const totalDiscSubtotalCents = Math.round(discountedUnitPrice * qty);
    const formattedSubtotal = 'Rs.' + (totalDiscSubtotalCents / 100).toLocaleString('en-US', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
    
    const priceEls = document.querySelectorAll('[data-subtotal-price]');
    if (priceEls.length > 0) {
      priceEls.forEach(el => {
        el.textContent = formattedSubtotal;
      });
    }

    const containerEls = document.querySelectorAll('subtotal-component, .product-subtotal, [data-testid="subtotal"], .product-form__subtotal');
    containerEls.forEach(el => {
      const existingBadge = el.querySelector('.boat-discount-badge');
      if (existingBadge) existingBadge.remove();
      const badge = document.createElement('span');
      badge.className = 'boat-discount-badge';
      badge.style.cssText = 'font-size:12px; color:#00c68c; font-weight:700; margin-left:6px;';
      badge.textContent = '(' + pct + '% Off Applied)';
      el.appendChild(badge);
    });
  }

  // Keep subtotal synced if quantity input is manually changed while card is active
  document.addEventListener('change', function(e) {
    if (e.target && (e.target.name === 'quantity' || e.target.classList.contains('quantity__input'))) {
      if (window.boatActiveOfferDiscountPct > 0 && window.boatBasePrice > 0) {
        const newQty = parseInt(e.target.value) || 1;
        setTimeout(function() {
          updateDiscountedSubtotalDisplay(newQty, window.boatActiveOfferDiscountPct, window.boatBasePrice);
        }, 60);
      }
    }
  });
</script>
{%- endif -%}


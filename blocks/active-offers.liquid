<div class="boat-active-offers-block" {{ block.shopify_attributes }}>

  <!-- Optional Collection / 2-Option Selector Section inside Active Offers -->
  {% if block.settings.enable_option_picker %}
    <div class="boat-active-offers-picker-section">
      {% if block.settings.picker_label != blank %}
        <label class="form__label boat-option-label">
          <span class="boat-choose-prefix">{{ block.settings.picker_label }}</span>
          <span class="boat-selected-option-title" id="active-offers-selected-option-{{ block.id }}">
            {% if block.settings.picker_type == 'collection' and block.settings.collection != blank %}
              {{ block.settings.collection.products.first.title | default: product.title }}
            {% else %}
              {{ block.settings.opt1_title }}
            {% endif %}
          </span>
        </label>
      {% endif %}

      <div class="collection-picker-options-grid">
        {% if block.settings.picker_type == 'collection' and block.settings.collection != blank %}
          {% for collection_product in block.settings.collection.products limit: block.settings.products_limit %}
            <a 
              href="{{ collection_product.url }}" 
              class="collection-picker-option-card{% if collection_product.id == product.id %} is-selected{% endif %}"
              title="{{ collection_product.title | escape }}"
            >
              {% if collection_product.featured_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ collection_product.featured_image | img_url: '100x100', crop: 'center' }}" alt="{{ collection_product.title | escape }}" loading="lazy" width="50" height="50">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ collection_product.title }}</span>
                <span class="collection-picker-price">{{ collection_product.price | money }}</span>
              </div>
            </a>
          {% endfor %}
        {% else %}
          <div 
            class="collection-picker-option-card is-selected" 
            onclick="selectActiveOfferOption(this, '{{ block.settings.opt1_title | escape }}')"
          >
            {% if block.settings.opt1_image %}
              <div class="collection-picker-img-wrapper">
                <img src="{{ block.settings.opt1_image | img_url: '100x100', crop: 'center' }}" alt="{{ block.settings.opt1_title | escape }}" loading="lazy" width="50" height="50">
              </div>
            {% endif %}
            <div class="collection-picker-info">
              <span class="collection-picker-title">{{ block.settings.opt1_title }}</span>
              {% if block.settings.opt1_price != blank %}
                <span class="collection-picker-price">{{ block.settings.opt1_price }}</span>
              {% endif %}
            </div>
          </div>

          {% if block.settings.enable_opt2 %}
            <div 
              class="collection-picker-option-card" 
              onclick="selectActiveOfferOption(this, '{{ block.settings.opt2_title | escape }}')"
            >
              {% if block.settings.opt2_image %}
                <div class="collection-picker-img-wrapper">
                  <img src="{{ block.settings.opt2_image | img_url: '100x100', crop: 'center' }}" alt="{{ block.settings.opt2_title | escape }}" loading="lazy" width="50" height="50">
                </div>
              {% endif %}
              <div class="collection-picker-info">
                <span class="collection-picker-title">{{ block.settings.opt2_title }}</span>
                {% if block.settings.opt2_price != blank %}
                  <span class="collection-picker-price">{{ block.settings.opt2_price }}</span>
                {% endif %}
              </div>
            </div>
          {% endif %}
        {% endif %}
      </div>
    </div>
  {% endif %}

  <!-- Active Offers Cards Section -->
  {% if block.settings.title != blank %}
    <h3 class="boat-offers-heading">{{ block.settings.title }}</h3>
  {% endif %}

  <div class="boat-offers-grid">
    <!-- Card 1 -->
    {% if block.settings.enable_card_1 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_1 != blank %}
          <div class="boat-offer-badge boat-offer-badge--1">{{ block.settings.badge_1 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_1 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_1 }}</div>
          {% if block.settings.code_1 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_1 }}')">
              <span>Code: <strong>{{ block.settings.code_1 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 2 -->
    {% if block.settings.enable_card_2 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_2 != blank %}
          <div class="boat-offer-badge boat-offer-badge--2">{{ block.settings.badge_2 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_2 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_2 }}</div>
          {% if block.settings.code_2 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_2 }}')">
              <span>Code: <strong>{{ block.settings.code_2 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}

    <!-- Card 3 -->
    {% if block.settings.enable_card_3 %}
      <div class="boat-offer-card">
        {% if block.settings.badge_3 != blank %}
          <div class="boat-offer-badge boat-offer-badge--3">{{ block.settings.badge_3 }}</div>
        {% endif %}
        <div class="boat-offer-content">
          <div class="boat-offer-title">{{ block.settings.title_3 }}</div>
          <div class="boat-offer-divider"></div>
          <div class="boat-offer-discount">{{ block.settings.discount_3 }}</div>
          {% if block.settings.code_3 != blank %}
            <button type="button" class="boat-offer-code-btn" onclick="copyOfferCode(this, '{{ block.settings.code_3 }}')">
              <span>Code: <strong>{{ block.settings.code_3 }}</strong></span>
              <svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><rect x="9" y="9" width="13" height="13" rx="2" ry="2"></rect><path d="M5 15H4a2 2 0 0 1-2-2V4a2 2 0 0 1 2-2h9a2 2 0 0 1 2 2v1"></path></svg>
              <span class="copied-tooltip">Copied!</span>
            </button>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</div>

<script>
  function copyOfferCode(btn, code) {
    if (!code) return;
    navigator.clipboard.writeText(code).then(function() {
      btn.classList.add('copied');
      setTimeout(function() {
        btn.classList.remove('copied');
      }, 1500);
    }).catch(function(err) {
      console.error('Failed to copy code: ', err);
    });
  }

  function selectActiveOfferOption(el, title) {
    const parent = el.closest('.collection-picker-options-grid');
    if (!parent) return;
    parent.querySelectorAll('.collection-picker-option-card').forEach(card => card.classList.remove('is-selected'));
    el.classList.add('is-selected');
    const labelTitle = document.getElementById('active-offers-selected-option-{{ block.id }}');
    if (labelTitle) labelTitle.textContent = title;
  }
</script>

{% schema %}

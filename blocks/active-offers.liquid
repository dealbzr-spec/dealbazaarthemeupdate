    },
    {
      "type": "text",
      "id": "opt2_price",
      "label": "Option 2 Price",
      "default": "Rs.3,198.00"
    },
    {
      "type": "image_picker",
      "id": "opt2_image",
      "label": "Option 2 Image"
    },
    {
      "type": "header",
      "content": "Active Offers Cards Settings"
    },
    {
      "type": "text",
      "id": "title",
      "label": "Offers Section Title",
      "default": "Active Offers"
    },
    {
      "type": "header",
      "content": "Card 1 Settings"
    },
    {
      "type": "checkbox",

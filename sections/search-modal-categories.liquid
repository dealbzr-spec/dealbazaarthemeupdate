{% schema %}
{
  "name": "Search Categories & Tags",
  "tag": "section",
  "class": "section-search-modal-categories",
  "settings": [
    {
      "type": "header",
      "content": "MOST SEARCHED AND BOUGHT CATEGORIES"
    },
    {
      "type": "text",
      "id": "search_modal_heading",
      "label": "Categories Section Title",
      "default": "Most Searched And Bought"
    },
    {
      "type": "collection_list",
      "id": "search_modal_categories",
      "label": "Select Collections (Most Searched And Bought)",
      "limit": 6,
      "info": "Select up to 6 collections to display in the 2-row grid inside the search popup."
    },
    {
      "type": "header",
      "content": "TOP SEARCH TAG PILLS"
    },
    {
      "type": "collection_list",
      "id": "search_tags_collections",
      "label": "Select Tag Collections",
      "limit": 15
    },
    {
      "type": "text",
      "id": "search_tags",
      "label": "Custom Tag Keywords (Comma Separated)",
      "default": "westpoint, smartwatch, earbuds, official warranty, clearance sale"
    }
  ],
  "blocks": [
    {
      "type": "search_tag_item",
      "name": "Search Tag Pill",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_label",
          "label": "Custom Tag Label (Optional)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link (Optional)"
        }
      ]
    },
    {
      "type": "search_category_card",
      "name": "Search Category Card",
      "settings": [
        {
          "type": "collection",
          "id": "collection",
          "label": "Select Collection"
        },
        {
          "type": "text",
          "id": "custom_title",
          "label": "Custom Title (Optional)"
        },
        {
          "type": "image_picker",
          "id": "custom_image",
          "label": "Custom Icon / Image (Optional)"
        },
        {
          "type": "url",
          "id": "custom_url",
          "label": "Custom Link (Optional)"
        }
      ]
    }
  ],
  "presets": [
    {
      "name": "Search Categories & Tags",
      "blocks": [
        {
          "type": "search_category_card"
        },
        {
          "type": "search_category_card"
        }
      ]
    }
  ]
}
{% endschema %}

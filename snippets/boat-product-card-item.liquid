{% liquid
  assign selected_variant = product.selected_or_first_available_variant
  assign price = selected_variant.price
  assign compare_price = selected_variant.compare_at_price
  
  assign discount_percent = 0
  if compare_price > price
    assign discount_amount = compare_price | minus: price
    assign discount_percent = discount_amount | times: 100 | divided_by: compare_price
  endif

  # Feature tag generator
  assign feature_tag = 'Powerful Sound'
  if product.title contains 'ANC' or product.tags contains 'ANC'
    assign feature_tag = 'Up To 35dB ANC'
  elsif product.title contains 'Bar' or product.title contains 'Speaker'
    assign feature_tag = '450W Powerful Sound'
  elsif product.title contains 'Watch'
    assign feature_tag = 'BT Calling'
  elsif product.title contains 'Earbuds' or product.title contains 'Air'
    assign feature_tag = '45 Hrs Playback'
  endif

  # Determine initial image
  assign featured_img = selected_variant.featured_image
  if featured_img == blank
    assign featured_img = product.featured_media.preview_image
  endif

  assign form_id = 'BoatProductCardForm-' | append: product.id | append: '-' | append: selected_variant.id
%}

<div class="boat-pick-card" data-product-id="{{ product.id }}">
  <a href="{{ product.url }}" class="boat-pick-card__image-link" aria-label="{{ product.title | escape }}">
    {% if compare_price > price %}
      <div class="boat-pick-card__badge">
        <span>⚡</span>
        <span>Sale</span>
      </div>
    {% else %}
      <div class="boat-pick-card__badge">
        <span>✨</span>
        <span>New Launch</span>
      </div>
    {% endif %}

    {% if featured_img != blank %}
      <img 
        src="{{ featured_img | image_url: width: 600 }}" 
        alt="{{ product.title | escape }}" 
        class="boat-pick-card__image"
        loading="lazy"
        width="300"
        height="300"
      >
    {% else %}
      <div style="width:100%; height:100%; background:#f1f5f9; display:flex; align-items:center; justify-content:center; font-size:2rem;">📦</div>
    {% endif %}
  </a>

  {% comment %} --- Yellow Feature Banner Bar --- {% endcomment %}
  <div class="boat-pick-card__yellow-bar">
    <span>{{ feature_tag }}</span>
    <span class="boat-pick-card__rating">⭐ 4.9</span>
  </div>

  <div class="boat-pick-card__details">
    <a href="{{ product.url }}" class="boat-pick-card__title">{{ product.title }}</a>

    <div class="boat-pick-card__price-row">
      <div class="boat-pick-card__price-wrap">
        <span class="boat-pick-card__price">{{ price | money }}</span>
        <span class="boat-pick-card__compare-price" style="{% unless compare_price > price %}display:none;{% endunless %}">
          {% if compare_price > price %}{{ compare_price | money }}{% endif %}
        </span>
        <span class="boat-pick-card__discount" style="{% unless compare_price > price %}display:none;{% endunless %}">
          {% if compare_price > price %}{{ discount_percent }}% off{% endif %}
        </span>
      </div>

      {% comment %} --- Dynamic Variant Swatch Dots --- {% endcomment %}
      {% if product.variants.size > 1 %}
        <div class="boat-pick-card__swatch-dots">
          {% for var in product.variants limit: 3 %}
            {% liquid
              assign var_discount = 0
              if var.compare_at_price > var.price
                assign var_diff = var.compare_at_price | minus: var.price
                assign var_discount = var_diff | times: 100 | divided_by: var.compare_at_price
              endif

              assign var_img_url = var.featured_image | default: featured_img | image_url: width: 600
              
              assign swatch_bg = '#0f172a'
              if forloop.index == 2
                assign swatch_bg = '#0284c7'
              elsif forloop.index == 3
                assign swatch_bg = '#16a34a'
              endif
            %}
            <button 
              type="button" 
              class="boat-swatch-dot{% if var.id == selected_variant.id %} active{% endif %}"
              style="background: {{ swatch_bg }};"
              title="{{ var.title }}"
              data-variant-id="{{ var.id }}"
              data-variant-image="{{ var_img_url }}"
              data-variant-price="{{ var.price | money }}"
              data-variant-compare="{% if var.compare_at_price > var.price %}{{ var.compare_at_price | money }}{% endif %}"
              data-variant-discount="{% if var.compare_at_price > var.price %}{{ var_discount }}% off{% endif %}"
              data-variant-available="{{ var.available }}"
              onclick="selectBoatVariant(this)"
            ></button>
          {% endfor %}

          {% if product.variants.size > 3 %}
            <span>+{{ product.variants.size | minus: 3 }}</span>
          {% endif %}
        </div>
      {% endif %}
    </div>

    {% comment %} --- Theme Native Add to Cart Component with Icon & Real-time AJAX Counter --- {% endcomment %}
    {% form 'product', product, id: form_id, class: 'boat-pick-card__form', data-type: 'add-to-cart-form', onsubmit: 'handleBoatAddToCart(event, this)' %}
      <input type="hidden" name="id" value="{{ selected_variant.id }}">
      
      {% render 'add-to-cart-button', 
        product: product, 
        can_add_to_cart: selected_variant.available, 
        add_to_cart_text: 'ADD TO CART', 
        class: 'boat-pick-card__add-btn' 
      %}
    {% endform %}
  </div>
</div>

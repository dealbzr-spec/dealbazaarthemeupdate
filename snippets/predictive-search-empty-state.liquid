{% doc %}
  Renders the predictive search empty state with DYNAMIC store collections & 2-row layout (SS1, SS2 & SS3 style)
{% enddoc %}

<div
  id="predictive-search-results"
  class="predictive-search-dropdown"
  role="listbox"
  aria-expanded="true"
>
  <div class="boat-search-modal-container" style="padding: 20px 24px;">
    
    {% comment %} --- Dynamic Section Heading --- {% endcomment %}
    <h3 class="boat-search-modal-title" style="font-size: 1.1rem; font-weight: 700; color: #1e293b; margin: 0 0 16px 0; font-family: 'Plus Jakarta Sans', sans-serif;">
      {{ section.settings.search_modal_heading | default: settings.search_modal_heading | default: 'Most Searched And Bought' }}
    </h3>

    {% assign modal_collections = section.settings.search_modal_categories | default: settings.search_modal_categories %}
    {% assign card_blocks = section.blocks | where: 'type', 'search_category_card' %}

    {% comment %} --- 2-Row Maximum Grid (Max 4 to 6 items) --- {% endcomment %}
    <div class="boat-search-modal-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px 20px;">
      {% if card_blocks.size > 0 %}
        {% for block in card_blocks limit: 6 %}
          {% assign col = block.settings.collection %}
          {% assign url = block.settings.custom_url | default: col.url | default: '#' %}
          {% assign title = block.settings.custom_title | default: col.title | default: 'Category' %}
          {% assign img = block.settings.custom_image | default: col.featured_image %}
          <a href="{{ url }}" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.88rem; font-family: 'Plus Jakarta Sans', sans-serif;" {{ block.shopify_attributes }}>
            <div style="width: 42px; height: 42px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
              {% if img != blank %}
                <img src="{{ img | image_url: width: 100 }}" alt="{{ title | escape }}" loading="lazy" width="42" height="42" style="width:100%;height:100%;object-fit:cover;">
              {% else %}
                <span style="font-size: 1.2rem;">🛍️</span>
              {% endif %}
            </div>
            <span>{{ title }}</span>
          </a>
        {% endfor %}
      {% elsif modal_collections != blank and modal_collections.size > 0 %}
        {% for collection in modal_collections limit: 6 %}
          <a href="{{ collection.url }}" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.88rem; font-family: 'Plus Jakarta Sans', sans-serif;">
            <div style="width: 42px; height: 42px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
              {% if collection.featured_image != blank %}
                <img src="{{ collection.featured_image | image_url: width: 100 }}" alt="{{ collection.title | escape }}" loading="lazy" width="42" height="42" style="width:100%;height:100%;object-fit:cover;">
              {% else %}
                <span style="font-size: 1.2rem;">🛍️</span>
              {% endif %}
            </div>
            <span>{{ collection.title }}</span>
          </a>
        {% endfor %}
      {% else %}
        {% assign count = 0 %}
        {% for collection in collections %}
          {% unless collection.handle == 'frontpage' %}
            {% assign count = count | plus: 1 %}
            {% if count <= 6 %}
              <a href="{{ collection.url }}" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 12px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.88rem; font-family: 'Plus Jakarta Sans', sans-serif;">
                <div style="width: 42px; height: 42px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
                  {% if collection.featured_image != blank %}
                    <img src="{{ collection.featured_image | image_url: width: 100 }}" alt="{{ collection.title | escape }}" loading="lazy" width="42" height="42" style="width:100%;height:100%;object-fit:cover;">
                  {% else %}
                    <span style="font-size: 1.2rem;">🛍️</span>
                  {% endif %}
                </div>
                <span>{{ collection.title }}</span>
              </a>
            {% endif %}
          {% endunless %}
        {% endfor %}
      {% endif %}
    </div>
  </div>
</div>

{% doc %}
  Renders the predictive search empty state with DYNAMIC store collections & Draggable Search Tag Pill Carousel (SS1, SS2 & SS4 style)
{% enddoc %}

<div
  id="predictive-search-results"
  class="predictive-search-dropdown"
  role="listbox"
  aria-expanded="true"
>
  <div class="boat-search-modal-container" style="padding: 20px 24px;">
    
    {% comment %} --- SS1 & SS4 Style Draggable / Swipeable Horizontal Search Tag Pills Carousel --- {% endcomment %}
    <div class="boat-search-tags-carousel" id="BoatSearchTagsCarousel">
      {% if section.settings.search_tags_collections != blank %}
        {% for collection in section.settings.search_tags_collections %}
          <a href="{{ collection.url }}" class="boat-search-tag-pill">
            {{ collection.title }}
          </a>
        {% endfor %}
      {% elsif settings.search_tags != blank %}
        {% assign tags = settings.search_tags | split: ',' %}
        {% for tag in tags %}
          {% assign clean_tag = tag | strip %}
          {% if clean_tag != blank %}
            <a href="{{ routes.search_url }}?q={{ clean_tag | url_param_escape }}" class="boat-search-tag-pill">
              {{ clean_tag }}
            </a>
          {% endif %}
        {% endfor %}
      {% else %}
        {% for collection in collections limit: 8 %}
          {% unless collection.handle == 'frontpage' %}
            <a href="{{ collection.url }}" class="boat-search-tag-pill">
              {{ collection.title }}
            </a>
          {% endunless %}
        {% else %}
          <a href="{{ routes.search_url }}?q=official+warranty" class="boat-search-tag-pill">official warranty</a>
          <a href="{{ routes.search_url }}?q=organizer" class="boat-search-tag-pill">organizer</a>
          <a href="{{ routes.search_url }}?q=oven" class="boat-search-tag-pill">oven</a>
          <a href="{{ routes.search_url }}?q=office" class="boat-search-tag-pill">office</a>
          <a href="{{ routes.search_url }}?q=home+office" class="boat-search-tag-pill">home office</a>
          <a href="{{ routes.search_url }}?q=office+school" class="boat-search-tag-pill">office school</a>
        {% endfor %}
      {% endif %}
    </div>

    {% comment %} --- SS2 DYNAMIC Store Collections ("Most Searched And Bought") --- {% endcomment %}
    <h3 class="boat-search-modal-title" style="font-size: 1.15rem; font-weight: 700; color: #1e293b; margin: 12px 0 20px 0; font-family: 'Plus Jakarta Sans', sans-serif;">
      Most Searched And Bought
    </h3>

    <div class="boat-search-modal-grid" style="display: grid; grid-template-columns: repeat(2, 1fr); gap: 16px 20px;">
      {% assign count = 0 %}
      {% for collection in collections %}
        {% unless collection.handle == 'frontpage' %}
          {% assign count = count | plus: 1 %}
          {% if count <= 14 %}
            <a href="{{ collection.url }}" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
              <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden; box-shadow: inset 0 0 0 1px rgba(0,0,0,0.05);">
                {% if collection.featured_image != blank %}
                  <img src="{{ collection.featured_image | image_url: width: 100 }}" alt="{{ collection.title | escape }}" loading="lazy" width="44" height="44" style="width:100%;height:100%;object-fit:cover;">
                {% else %}
                  <span style="font-size: 1.2rem;">🛍️</span>
                {% endif %}
              </div>
              <span>{{ collection.title }}</span>
            </a>
          {% endif %}
        {% endunless %}
      {% endfor %}

      {% if count == 0 %}
        {% comment %} Dynamic Fallback when store has no custom collections yet {% endcomment %}
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">🎧</div>
          <span>True Wireless Earphones</span>
        </a>
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">🎁</div>
          <span>Personalized Products</span>
        </a>
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">⌚</div>
          <span>Smart Watches</span>
        </a>
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">✨</div>
          <span>Nirvana</span>
        </a>
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">🎧</div>
          <span>Wireless Neckbands</span>
        </a>
        <a href="/collections/all" class="boat-search-modal-card" style="display: flex; align-items: center; gap: 14px; text-decoration: none; color: #1e293b; font-weight: 600; font-size: 0.9rem; font-family: 'Plus Jakarta Sans', sans-serif;">
          <div style="width: 44px; height: 44px; border-radius: 50%; background: #f1f5f9; display: flex; align-items: center; justify-content: center; flex-shrink: 0; font-size: 1.3rem;">🔊</div>
          <span>Bluetooth Speakers</span>
        </a>
      {% endif %}
    </div>
  </div>
</div>

{% comment %} --- Mouse Drag & Touch Slide Script for Search Tag Pills --- {% endcomment %}
<script>
  (function() {
    function initDragScroll() {
      const slider = document.getElementById('BoatSearchTagsCarousel');
      if (slider && !slider.dataset.dragInit) {
        slider.dataset.dragInit = 'true';
        let isDown = false;
        let startX;
        let scrollLeft;
        let isDragging = false;

        slider.addEventListener('mousedown', (e) => {
          isDown = true;
          isDragging = false;
          slider.style.cursor = 'grabbing';
          startX = e.pageX - slider.offsetLeft;
          scrollLeft = slider.scrollLeft;
        });

        slider.addEventListener('mouseleave', () => {
          isDown = false;
          slider.style.cursor = 'grab';
        });

        slider.addEventListener('mouseup', (e) => {
          isDown = false;
          slider.style.cursor = 'grab';
          if (isDragging) {
            e.preventDefault();
          }
        });

        slider.addEventListener('mousemove', (e) => {
          if (!isDown) return;
          const x = e.pageX - slider.offsetLeft;
          const walk = (x - startX) * 2.5;
          if (Math.abs(walk) > 5) {
            isDragging = true;
          }
          slider.scrollLeft = scrollLeft - walk;
        });

        // Prevent clicking links while dragging
        slider.querySelectorAll('a').forEach(link => {
          link.addEventListener('click', (e) => {
            if (isDragging) {
              e.preventDefault();
              e.stopPropagation();
            }
          });
        });
      }
    }
    if (document.readyState === 'loading') {
      document.addEventListener('DOMContentLoaded', initDragScroll);
    } else {
      initDragScroll();
    }
  })();
</script>

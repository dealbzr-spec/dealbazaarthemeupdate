{% liquid
  assign link_count = parent_link.links.size
%}

<div class="boat-megamenu-wrapper" style="width: 100%; max-width: 1280px; margin: 0 auto; display: flex; justify-content: flex-start;">
  <div class="boat-megamenu-grid" style="display: flex; flex-wrap: wrap; justify-content: flex-start; align-items: center; gap: 20px 36px; width: 100%; margin: 0; padding: 0; list-style: none;">
    {% if link_count > 0 %}
      {% for link in parent_link.links %}
        <a href="{{ link.url }}" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212; border-radius: 8px; transition: all 0.2s ease;">
          <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0; overflow: hidden;">
            {% if link.type == 'collection_link' and link.object.featured_image != blank %}
              <img src="{{ link.object.featured_image | image_url: width: 100 }}" alt="{{ link.title | escape }}" loading="lazy" width="44" height="44" style="width:100%; height:100%; object-fit:cover;">
            {% elsif link.type == 'product_link' and link.object.featured_image != blank %}
              <img src="{{ link.object.featured_image | image_url: width: 100 }}" alt="{{ link.title | escape }}" loading="lazy" width="44" height="44" style="width:100%; height:100%; object-fit:cover;">
            {% else %}
              <span style="font-size: 1.3rem;">📱</span>
            {% endif %}
          </div>
          <span class="boat-megamenu-title" style="font-size: 0.86rem; font-weight: 600; color: #1a1a1a;">{{ link.title }}</span>
        </a>
      {% endfor %}
    {% else %}
      {% comment %} --- SAME TO SAME boAt Category Items (Matching Image) --- {% endcomment %}
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🎧</span></div>
        <span class="boat-megamenu-title">True Wireless Earbuds</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🎧</span></div>
        <span class="boat-megamenu-title">Neckbands</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">⌚</span></div>
        <span class="boat-megamenu-title">Smart Watches</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🎧</span></div>
        <span class="boat-megamenu-title">Headphones</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🔊</span></div>
        <span class="boat-megamenu-title">Wireless Speakers</span>
      </a>

      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🔈</span></div>
        <span class="boat-megamenu-title">Soundbars</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">📻</span></div>
        <span class="boat-megamenu-title">Party Speakers</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">🔋</span></div>
        <span class="boat-megamenu-title">Power Banks</span>
      </a>
      <a href="/collections/all" class="boat-megamenu-card" style="display: inline-flex; align-items: center; gap: 12px; padding: 6px 12px; text-decoration: none; color: #121212;">
        <div class="boat-megamenu-avatar" style="width: 44px; height: 44px; border-radius: 50%; background: #f2f4f8; display: flex; align-items: center; justify-content: center; flex-shrink: 0;"><span style="font-size: 1.3rem;">📷</span></div>
        <span class="boat-megamenu-title">Dashcams</span>
      </a>
    {% endif %}
  </div>
</div>
